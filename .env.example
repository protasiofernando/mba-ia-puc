# Credenciais/config da LLM do pipeline (Stages 2 a 6) e da previa do painel.
# Copie para .env e preencha. NAO versionar (.env ja esta no .gitignore).
#
# Escolha UM provedor. Se houver mais de um, PIPELINE_LLM_PROVIDER decide.

# ─── Opcao A: Ollama (LLM local, ex.: GPU on-prem) - RECOMENDADO p/ base grande ───
# Suba o Ollama na maquina com GPU e baixe os modelos vigentes:
#   ollama pull llama3.3:70b
#   ollama pull qwen3:30b-a3b-instruct-2507-q4_K_M
# Se o Ollama estiver em outra maquina, aponte OLLAMA_BASE_URL para ela.
OLLAMA_MODEL=
OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_TIMEOUT=600
# LLM_TIMEOUT=90

# ─── Opcao B: OpenAI padrao (api.openai.com) ───
OPENAI_API_KEY=
PIPELINE_OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# ─── Opcao C: Azure OpenAI ───
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=gpt-4.1
AZURE_OPENAI_API_VERSION=2025-01-01-preview

# ─── Ajustes do pipeline ───
# Forca o provedor quando houver mais de uma credencial: ollama | openai | azure
PIPELINE_LLM_PROVIDER=
# Chamadas concorrentes. Ollama local: use conforme a GPU/num_parallel (ex.: 2 a 8).
PIPELINE_WORKERS=4
# STAGE5_WORKERS=2

# Stage 3 hierarquico.
# STAGE3_DISCOVERY_BATCH_SIZE=200
# STAGE3_OUTLIER_MAX_ROUNDS=8
# STAGE3_OUTLIER_MIN_GROUP_SIZE=2
# STAGE3_OUTLIER_SUMMARY_BATCH_SIZE=200
# STAGE3_MERGE_CHAR_BUDGET=12000
# STAGE3_MERGE_MAX_RECORDS=20
# STAGE3_PLAN_MAX_TOKENS=9000
# STAGE3_JSON_MAX_TOKENS=9000
# STAGE3_GLOBAL_CHAR_BUDGET=60000
# STAGE3_GLOBAL_MAX_RECORDS=160
# STAGE3_JSON_MODEL=qwen3:30b-a3b-instruct-2507-q4_K_M
# STAGE3_RANDOM_SEED=42

# Stage 5 reconciliacao operacional.
# STAGE5_JSON_MODEL=qwen3:30b-a3b-instruct-2507-q4_K_M
# STAGE5_RECONCILE_PLAN_MAX_TOKENS=10000
# STAGE5_RECONCILE_JSON_BLOCK_MAX_TOKENS=2000

# ─── Dashboard local ───
# Seleção do motor da simulação: ollama | azure. Vazio prefere Ollama local e
# usa Azure somente como fallback quando não há OLLAMA_MODEL.
DASHBOARD_LLM_PROVIDER=
# DASHBOARD_LLM_TIMEOUT=90
# Mantém o Flask restrito à máquina local por padrão. Altere conscientemente se
# precisar expor o painel em uma rede controlada.
DASHBOARD_HOST=127.0.0.1
# PORT=5000
